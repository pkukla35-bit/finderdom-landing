{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "api/fonts/**"
    },
    "api/subscribe.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/index" },
    { "source": "/api/payments/:path*", "destination": "/api/index" },
    { "source": "/api/valuation/:path*", "destination": "/api/index" },
    { "source": "/api/invoices/:path*", "destination": "/api/index" },
    { "source": "/api/invoices", "destination": "/api/index" },
    { "source": "/api/leads/:path*", "destination": "/api/index" },
    { "source": "/api/offer-status", "destination": "/api/index" },
    { "source": "/api/offer-status/:path*", "destination": "/api/index" },
    { "source": "/api/team/:path*", "destination": "/api/index" },
    { "source": "/api/debug/:path*", "destination": "/api/index" },
    { "source": "/api/health", "destination": "/api/index" },
    { "source": "/api/docs", "destination": "/api/index" },
    { "source": "/platnosc-sukces", "destination": "/platnosc-sukces.html" },
    { "source": "/platnosc-anulowana", "destination": "/platnosc-anulowana.html" },
    { "source": "/wycena-sukces", "destination": "/wycena-sukces.html" },
    { "source": "/wycena", "destination": "/wycena.html" },
    { "source": "/lead-claim", "destination": "/lead-claim.html" },
    { "source": "/pomoc", "destination": "/pomoc.html" },
    { "source": "/pomoc/rejestracja", "destination": "/pomoc-rejestracja.html" },
    { "source": "/pomoc/szukaj", "destination": "/pomoc-szukaj.html" },
    { "source": "/pomoc/wycena", "destination": "/pomoc-wycena.html" },
    { "source": "/zespol", "destination": "/zespol.html" },
    { "source": "/regulamin", "destination": "/regulamin.html" },
    { "source": "/polityka-prywatnosci", "destination": "/polityka-prywatnosci.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*).(png|jpg|jpeg|svg|ico|webp)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
